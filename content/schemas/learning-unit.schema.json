{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ap2.local/schemas/learning-unit.schema.json",
  "title": "Kompakte AP2-Lerneinheit",
  "type": "object",
  "required": ["meta", "objectives", "intro", "curation", "sections"],
  "properties": {
    "$schema": { "type": "string" },
    "meta": {
      "type": "object",
      "required": ["id", "slug", "title", "description", "domain", "domainLabel", "groupId", "groupLabel", "itemId", "week", "estimatedMinutes", "relevance", "sources", "contentRevision", "contentStatus"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 8 },
        "description": { "type": "string", "minLength": 20 },
        "domain": { "enum": ["GA1", "GA2", "WiSo"] },
        "domainLabel": { "type": "string" },
        "groupId": { "type": "string", "pattern": "^(ga1|ga2|wiso)-[0-9]+$" },
        "groupLabel": { "type": "string" },
        "itemId": { "type": "string", "pattern": "^(ga1|ga2|wiso)-[0-9]+__[0-9]+$" },
        "week": { "type": "string" },
        "estimatedMinutes": { "type": "integer", "minimum": 5 },
        "relevance": { "type": "string" },
        "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "contentRevision": { "type": "string" },
        "contentStatus": { "enum": ["CURATED_DRAFT", "DIDACTICALLY_REVIEWED", "PUBLICATION_READY"] }
      },
      "additionalProperties": false
    },
    "objectives": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 12 }
        },
        "additionalProperties": false
      }
    },
    "intro": { "type": "string", "minLength": 40 },
    "curation": {
      "type": "object",
      "required": ["evidence"],
      "properties": {
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["sourceId", "sourceLocator", "use", "reviewStatus"],
            "properties": {
              "sourceId": { "type": "string" },
              "sourceLocator": { "type": "string" },
              "use": { "type": "string" },
              "reviewStatus": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "type": { "enum": ["layers", "flow", "comparison", "topology"] },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["label", "detail"],
              "properties": {
                "label": { "type": "string" },
                "detail": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "nodes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "label", "x", "y"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "label": { "type": "string" },
                "detail": { "type": "string" },
                "x": { "type": "number" },
                "y": { "type": "number" },
                "kind": { "type": "string", "pattern": "^[a-z0-9-]+$" }
              },
              "additionalProperties": false
            }
          },
          "edges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["from", "to"],
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "label": { "type": "string" },
                "kind": { "type": "string", "pattern": "^[a-z0-9-]+$" }
              },
              "additionalProperties": false
            }
          },
          "zones": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "x", "y", "width", "height"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "label": { "type": "string" },
                "x": { "type": "number" },
                "y": { "type": "number" },
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "kind": { "type": "string", "pattern": "^[a-z0-9-]+$" }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "topology" } }, "required": ["type"] },
            "then": { "required": ["nodes", "edges"] },
            "else": { "required": ["items"] }
          }
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["title", "blocks"],
        "properties": {
          "title": { "type": "string" },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "enum": ["markdown", "quiz", "callout", "math", "figure", "recall", "flashcards", "numeric", "sequence"] }
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
